{
  "name": "companyconnect-operations-blueprint",
  "version": "1.0.1",
  "private": false,
  "description": "Client-safe reference implementation for AI-assisted lead-to-cash, operations, support, KPI, and audit workflows.",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "check": "tsc --noEmit && eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc -p tsconfig.build.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "benchmark": "tsx scripts/benchmark.ts",
    "verify:contract": "vitest run test/openapiContract.test.ts",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "sbom": "npm sbom --sbom-format cyclonedx --omit=dev"
  },
  "dependencies": {
    "express": "4.22.3",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/express": "5.0.1",
    "@types/node": "26.6.5",
    "@types/supertest": "7.2.1",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  }
}
